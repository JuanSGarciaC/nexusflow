    {
      "id": 7,
      "type": "timeseries",
      "title": "Peticiones por segundo según estado HTTP",
      "description": "Los 4xx incluyen los 429 del rate limiting y los 401/403 esperables.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(nexusflow_http_requests_total{status=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "2xx",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(nexusflow_http_requests_total{status=~\"3..\"}[$__rate_interval]))",
          "legendFormat": "3xx",
          "refId": "B",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(nexusflow_http_requests_total{status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "refId": "C",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(nexusflow_http_requests_total{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "refId": "D",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
