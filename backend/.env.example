# Variables para ejecutar el backend SIN Docker (desarrollo local).
# Copia este archivo a backend/.env; la aplicación lo lee automáticamente.
# Generar secretos: python -c "import secrets; print(secrets.token_hex(32))"

NEXUSFLOW_ENV=development
NEXUSFLOW_LOG_LEVEL=INFO
# false = formato legible en consola; true = JSON (recomendado en Docker y CI).
NEXUSFLOW_LOG_JSON=false

NEXUSFLOW_DATABASE_URL=postgresql+asyncpg://nexusflow:change-me@localhost:5432/nexusflow
NEXUSFLOW_REDIS_URL=redis://:change-me@localhost:6379/0
NEXUSFLOW_SECRET_KEY=change-me-generate-at-least-32-random-characters

NEXUSFLOW_CORS_ORIGINS=http://localhost:5173
NEXUSFLOW_DOCS_ENABLED=true

# --- Solo para pytest: bases separadas para no tocar los datos de desarrollo ---
# NEXUSFLOW_TEST_DATABASE_URL=postgresql+asyncpg://nexusflow:change-me@localhost:5432/nexusflow_test
# NEXUSFLOW_TEST_REDIS_URL=redis://:change-me@localhost:6379/15
