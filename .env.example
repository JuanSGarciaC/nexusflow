# Variables para `docker compose`. Copia este archivo a `.env` (que está en .gitignore)
# y reemplaza TODOS los valores marcados con change-me.
#
# Generar valores seguros (sirve en PowerShell, CMD y bash):
#   python -c "import secrets; print(secrets.token_hex(32))"
# Usa token_hex para las contraseñas: así no contienen caracteres que rompan las URLs.

# --- PostgreSQL ---
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=nexusflow

# --- Redis ---
REDIS_PASSWORD=change-me-redis-password

# --- API ---
# development | test | production. En production se rechazan los valores de ejemplo.
NEXUSFLOW_ENV=development
# Mínimo 32 caracteres aleatorios.
NEXUSFLOW_SECRET_KEY=change-me-generate-at-least-32-random-characters
# Clave(s) Fernet para cifrar credenciales de integraciones, separadas por comas
# (la primera cifra; todas descifran). Generar:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# o, con el backend instalado: nexusflow generate-key
NEXUSFLOW_CREDENTIALS_ENCRYPTION_KEYS=change-me-generate-a-fernet-key
NEXUSFLOW_LOG_LEVEL=INFO
NEXUSFLOW_LOG_JSON=true
# Orígenes permitidos por CORS, separados por comas (el frontend llegará en la Fase 8).
NEXUSFLOW_CORS_ORIGINS=
NEXUSFLOW_DOCS_ENABLED=true
# Token para que Prometheus lea /metrics (Bearer). Vacío = /metrics deshabilitado.
# Generar: python -c "import secrets; print(secrets.token_hex(24))"
NEXUSFLOW_METRICS_TOKEN=

# --- Autenticación ---
NEXUSFLOW_ACCESS_TOKEN_TTL_MINUTES=15
NEXUSFLOW_REFRESH_TOKEN_TTL_DAYS=7
NEXUSFLOW_REGISTRATION_ENABLED=true
# Debe ser true en producción. Los navegadores aceptan cookies Secure en http://localhost.
NEXUSFLOW_COOKIE_SECURE=true

# --- Límites de uso ---
NEXUSFLOW_LOGIN_RATE_LIMIT_PER_IP=20
NEXUSFLOW_LOGIN_RATE_LIMIT_PER_EMAIL=10
NEXUSFLOW_REGISTER_RATE_LIMIT_PER_IP=5

# --- Motor de ejecución ---
NEXUSFLOW_RUN_MAX_DURATION_HOURS=48
# Seguridad de salida (anti-SSRF). En producción: false y vacío.
NEXUSFLOW_EGRESS_ALLOW_HTTP=false
# Hosts que pueden resolver a IPs privadas, separados por comas (solo desarrollo).
NEXUSFLOW_EGRESS_ALLOWED_PRIVATE_HOSTS=
API_PORT=8000
# Panel web: http://127.0.0.1:3000
WEB_PORT=3000

# --- Demo: API externa simulada (docker compose --profile demo) ---
MOCK_PARTNER_CRM_TOKEN=change-me-crm-token
MOCK_PARTNER_PAYMENTS_KEY=change-me-payments-key
# Secreto con el que mock-partner verifica los webhooks salientes (mínimo 32 caracteres).
MOCK_PARTNER_WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars
MOCK_PARTNER_PORT=8080
